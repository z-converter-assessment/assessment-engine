#!/usr/bin/env bash
# git commit-msg hook — AI 메타데이터 차단 (강제 게이트).
# 설치: git config core.hooksPath .githooks.
#
# type prefix(Conventional Commits)·이모지 컨벤션은 Claude Code 가 작성 시 적용한다(/ship·/pr 스킬 +
# 글로벌 CLAUDE.md 항상 로드) — 순수 중복이라 훅에서 제거. AI 메타데이터만 훅으로 남긴다: 이 환경의
# 기본 지시가 "Co-Authored-By: Claude 추가"라 글로벌 규칙과 충돌하므로, 새어나와도 최종 하드 차단
# (누가 어떤 경로로 커밋하든). 정책 단일 진실: 글로벌 CLAUDE.md (AI 표식 금지).
set -euo pipefail

MSG_FILE="$1"

# AI 메타데이터 차단 (글로벌 CLAUDE.md — 어떤 산출물에도 금지). 환경 기본값이 Co-Authored-By 를 밀어도 차단.
if grep -qiE 'Co-Authored-By:.*(Claude|Anthropic)|Generated with .*Claude|Claude Code' "$MSG_FILE"; then
  echo "commit-msg 거부: AI 메타데이터(Co-Authored-By: Claude / Generated with Claude Code) 포함 금지" >&2
  exit 1
fi
exit 0
