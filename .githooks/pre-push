#!/usr/bin/env bash
# git pre-push hook — main/master/develop 직접 push 차단 (방식 무관 강제 게이트).
# 설치: git config core.hooksPath .githooks.
# feature -> develop PR, develop -> main PR 경유. release 는 main 에 tag(v*) push. 불가피 시 --no-verify.
# 로컬 CI 는 돌리지 않는다 — 검증은 GitHub CI(main PR 에서만)로 위임, 로컬 push 게이트는 보호 브랜치 방어만.
set -euo pipefail

# stdin: <local ref> <local sha> <remote ref> <remote sha> (push 대상 ref 마다 1줄)
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/develop)
      echo "pre-push 거부: $remote_ref 직접 push 금지 — PR 경유." >&2
      echo "  feature -> develop PR, develop -> main PR. release 는 main 에 tag(v*) push. 불가피 시 --no-verify (권장 안 함)." >&2
      exit 1
      ;;
  esac
done
exit 0
