# dev 환경변수 카탈로그 — `cp env.dev.example .env && docker compose up` (base + override.yml 자동 머지, 핫리로드).
# host 값(POSTGRES_HOST 등)은 compose 서비스명. prod 배포 템플릿은 루트 env.example.
# dev 는 weak default secret 을 거부하지 않음(APP_ENV=dev) — 아래 값 그대로 기동 가능.

# ────────────────────────────────────────────────────────────────────────────
# 1. 공통 — web · consumer 의무
# ────────────────────────────────────────────────────────────────────────────

APP_ENV=dev
#LOG_FORMAT=text

# PostgreSQL (TimescaleDB) — compose 서비스명
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# Redis — compose 서비스명
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ — EXCHANGE/ROUTING_KEY_* 는 agent <-> consumer routing 계약(양쪽 동기화).
# 외부 호스트의 agent 는 host 의 5672 publish 포트로 발행.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=assessment
RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# task.install 발행 / task.result 수신 — collector exchange 와 분리. agent WORKER_TASK_* 와 값 일치.
RABBITMQ_TASK_EXCHANGE=assessment.tasks
RABBITMQ_TASK_QUEUE_PREFIX=agent.tasks
RABBITMQ_TASK_INSTALL_KEY_PREFIX=task.install
RABBITMQ_ROUTING_KEY_TASK_RESULT=task.result
RABBITMQ_QUEUE_WORKER_RESULT=worker.result

#SQLALCHEMY_ECHO=false

# ────────────────────────────────────────────────────────────────────────────
# 2. web 전용
# ────────────────────────────────────────────────────────────────────────────

WEB_PORT=8000

# ZDM 좌표 — install 모달 기본 입력값(install task download.url host). 실 ZDM 으로 교체.
ZDM_DEFAULT_IP=192.168.3.94
#ZDM_DEFAULT_USER=admin@zconverter.com
#INSTALL_TIMEOUT_SEC=600

# 프로젝트명 고정 — down/up 시 -p dev 불필요(없으면 디렉토리명으로 오인식).
COMPOSE_PROJECT_NAME=dev
