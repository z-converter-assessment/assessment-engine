# 에이전트가 읽지 않을 것. 노출되면 안 되는 것과, 읽어봐야 토큰만 쓰는 것을 뺀다.

# 시크릿 — 응답·로그에 한 번 노출되면 회수할 수 없다.
.env
.env.*
# 템플릿은 커밋한다 — 위 패턴에 걸리므로 되돌린다.
!.env.example
!.env.dev.example
*.pem
*.key
secrets/

# 버전 관리 / IDE
.git/
.idea/
.vscode/

# 런타임 · 캐시
.venv/
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage*.xml
htmlcov/

# 빌드 산출물
dist/
build/
*.egg-info/

# vendored 라이브러리 — 읽을 일이 없고 토큰만 소모한다.
src/assessment_engine/web/static/js/vendor/
