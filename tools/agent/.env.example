RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=assessment
RABBITMQ_PASS=assessment
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=
RABBITMQ_ROUTING_KEY=metric
PUBLISH_INTERVAL_SEC=60
EXTERNAL_IP=111.111.111.111  # 고객사 네트워크 공용 IP (설치 시 관리자가 주입)
DRY_RUN=0                    # 1이면 MQ 없이 페이로드만 stdout 출력
# HOSTNAME_OVERRIDE=         # 비워두면 컨테이너 hostname 사용 (스케일 시 자동으로 달라짐)