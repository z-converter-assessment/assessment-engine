


{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],


    "paths": {
      "@/*": ["./src/assessment_engine/web/static/js/*.js"]
    }
  },
  "include": ["src/assessment_engine/web/static/js/**/*.js", "src/assessment_engine/web/static/js/**/*.ts"],
  "exclude": ["node_modules", "src/assessment_engine/web/static/js/vendor/**"]
}
