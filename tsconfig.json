{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["src/assessment_engine/web/static/js/**/*.js", "src/assessment_engine/web/static/js/**/*.ts"],
  "exclude": ["node_modules", "src/assessment_engine/web/static/js/vendor/**"]
}
