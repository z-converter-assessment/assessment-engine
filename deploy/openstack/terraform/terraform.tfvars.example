# 본 파일을 `terraform.tfvars`로 복사 후 실 값 채움. terraform.tfvars는 gitignore.

# OpenStack image 이름 (Horizon → Images에서 확인)
image_name = "Ubuntu-22.04-LTS"

# Horizon에 등록한 SSH keypair 이름
keypair_name = "assessment-engine-key"

# 사내 사설망 id (운영자 발급 또는 Horizon → Network → Networks에서 확인)
network_id = "00000000-0000-0000-0000-000000000000"

# Flavor 이름 (Horizon → Compute → Flavors)
db_flavor  = "m1.large"     # 권장 4 vCPU · 8 GB
mw_flavor  = "m1.medium"    # 권장 2 vCPU · 4 GB
app_flavor = "m1.medium"    # 권장 2 vCPU · 4 GB
