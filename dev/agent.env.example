# 에이전트 secret·라우팅 채널 (엔진 dev/.env 와 분리). dev-up.sh 가 source -> VM /etc/assessment-agent.env 주입.
# 없으면 dev-up.sh 가 example 자동 cp. 값 그대로 dev 동작. RABBITMQ_HOST 는 미정의 — dev-up.sh 가
# libvirt 게이트웨이 IP 주입. EXCHANGE/ROUTING_KEY_* 는 엔진 consumer 와 동일 (routing 계약).

RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# worker — RABBITMQ_WORKER_USER 비면 worker 비활성. dev 는 동일 user.
RABBITMQ_WORKER_USER=assessment
RABBITMQ_WORKER_PASSWORD=assessment
WORKER_TASK_EXCHANGE=assessment.tasks
WORKER_TASK_QUEUE_PREFIX=agent.tasks
WORKER_TASK_RESULT_KEY=task.result

# 다운로드 whitelist — install download.url host 가 본 목록에 있어야 수락(아니면 url_not_allowed). 엔진 ZDM_DEFAULT_IP host 와 일치.
WORKER_DOWNLOAD_ALLOWED_HOSTS=192.168.0.12
