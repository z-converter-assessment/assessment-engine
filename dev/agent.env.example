# 에이전트 secret 채널. 엔진의 .env와 분리.
# pipeline-up.sh가 본 파일을 source해 host env로 export 후, ssh <name>@orb heredoc 치환으로 VM 안
# /etc/assessment-agent.env에 옮긴다.
#
# 사용법:
#   cp infra/agent.env.example infra/agent.env
#   # 운영 값으로 수정 후 `./pipeline-up.sh` 재실행
#
# RABBITMQ_HOST는 pipeline-up.sh가 "host.docker.internal"(OrbStack 이 컨테이너·VM 양쪽에서 host 로 해석)로 별도 주입 — 본 파일에서 정의하지 않음.
# EXCHANGE/ROUTING_KEY_*는 엔진 consumer와 동일 값을 써야 한다 (routing 계약).

RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# 원격 작업 worker. RABBITMQ_WORKER_USER가 비어 있으면 worker 자체가 비활성.
# dev에서는 동일 user로 단순화 (prod는 publish-only / worker 권한 분리 ADR로 별도 결정).
RABBITMQ_WORKER_USER=assessment
RABBITMQ_WORKER_PASSWORD=assessment
WORKER_TASK_EXCHANGE=assessment.tasks
WORKER_TASK_QUEUE_PREFIX=agent.tasks
WORKER_TASK_RESULT_KEY=task.result
# 다운로드 도메인 whitelist. OrbStack dev에서는 host (engine self-host endpoint) 만 허용.
WORKER_DOWNLOAD_ALLOWED_HOSTS=host.docker.internal