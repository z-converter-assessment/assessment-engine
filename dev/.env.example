# dev 파이프라인 env 카탈로그 — `cp dev/.env.example dev/.env` (dev-up.sh 자동). compose 가 ENV_FILE=dev/.env 인식.
# host 값(POSTGRES_HOST 등)은 compose 서비스명. 배포 템플릿은 루트 env.example.

# ────────────────────────────────────────────────────────────────────────────
# 1. 공통 — web · consumer · diagnostic-worker 모두 의무
# ────────────────────────────────────────────────────────────────────────────

APP_ENV=dev
#LOG_FORMAT=text

# PostgreSQL (TimescaleDB) — compose 서비스명
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# pgAdmin 웹 관리 UI (http://localhost:5050) — 로그인 계정. 이메일은 유효 형식 필수(.local 거부).
# DB 'assessment' 서버는 servers.json 자동 등록 + dev override /pgpass(dev-up.sh 생성)로 무입력 연결.
PGADMIN_EMAIL=assessment@zconverter.com
PGADMIN_PASSWORD=assessment
PGADMIN_PORT=5050

# Redis — compose 서비스명
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ — 에이전트는 dev/agent.env 별도(libvirt VM). EXCHANGE/ROUTING_KEY_* 는 agent<->consumer 계약(양쪽 동기화).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# task.install 발행 / task.result 수신 — collector exchange 와 분리. agent WORKER_TASK_* 와 값 일치.
RABBITMQ_TASK_EXCHANGE=assessment.tasks
RABBITMQ_TASK_QUEUE_PREFIX=agent.tasks
RABBITMQ_TASK_INSTALL_KEY_PREFIX=task.install
RABBITMQ_ROUTING_KEY_TASK_RESULT=task.result
RABBITMQ_QUEUE_WORKER_RESULT=worker.result

#SQLALCHEMY_ECHO=false

# ────────────────────────────────────────────────────────────────────────────
# 2. web 전용
# ────────────────────────────────────────────────────────────────────────────

WEB_PORT=8000

# ZDM 좌표 — install task download.url host. dev 기본값=홈서버 LAN IP(VM 이 도달하는 ZDM mock). 실 ZDM 으로 교체.
ZDM_DEFAULT_IP=192.168.0.12:8000
#ZDM_DEFAULT_USER=admin@zconverter.com
# resolver fetch host — dev mock 은 web 자신이라 hairpin 불가 -> localhost. 실 ZDM(운영) 사용 시 비움.
ZDM_RESOLVER_HOST_OVERRIDE=localhost:8000
#INSTALL_TIMEOUT_SEC=600

# ────────────────────────────────────────────────────────────────────────────
# 3. 진단 publish — web · diagnostic-worker 공유
# ────────────────────────────────────────────────────────────────────────────

#RABBITMQ_ROUTING_KEY_DIAGNOSTIC=diagnostic.request

# ────────────────────────────────────────────────────────────────────────────
# 4. diagnostic-worker 전용
# ────────────────────────────────────────────────────────────────────────────

# LLM narrative — ollama 단독(ADR 0025). dev compose 는 ollama 미포함(LLM 실패 경로 재현) — `ollama` 호스트 DNS 미해석 의도.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:1.5b
