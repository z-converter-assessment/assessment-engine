# dev compose 기준 환경변수 카탈로그 (#A0). 본 디렉토리의 docker-compose.yml 이 본 파일을 source.
# `cp dev/.env.example dev/.env` 후 그대로 사용 가능 (scripts/pipeline-up.sh 가 자동 cp).
#
# host 값 (POSTGRES_HOST · REDIS_HOST · RABBITMQ_HOST) 은 docker compose 서비스명 — 같은
# compose network 안에서만 DNS 해석. 분산 배포 (VM 별 다른 호스트) 에는 인식 안 됨.
# prod 운영은 본 파일이 아니라 루트 `.env.example` 카탈로그를 참조 (docs/operations/env.md).

# ────────────────────────────────────────────────────────────────────────────
# 1. 공통 — web · consumer · diagnostic-worker 모두 의무
# ────────────────────────────────────────────────────────────────────────────

# 환경 마커. prod 일 때 model_validator 가 weak default 거부 (#F8).
APP_ENV=dev
# 로그 출력 format. text=dev colorized·grep 친화, json=prod 외부 log aggregator.
#LOG_FORMAT=text

# PostgreSQL (TimescaleDB) — docker compose 서비스명
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# Redis — docker compose 서비스명
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ broker 접속 + routing 계약
# - 에이전트는 본 .env 를 안 씀 — pipeline-up.sh 가 dev/agent.env 를 Lima VM 안
#   /etc/assessment-agent.env 로 옮긴다. 에이전트의 RABBITMQ_HOST 는
#   "host.lima.internal"(Lima user-mode network alias) 로 별도 주입.
# - EXCHANGE / ROUTING_KEY_* 는 에이전트 ↔ consumer routing 계약. 변경 시 양쪽 동시 동기화.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# SQLAlchemy 엔진 SQL 로깅 (dev 디버깅용).
#SQLALCHEMY_ECHO=false

# ────────────────────────────────────────────────────────────────────────────
# 2. web 전용 — consumer · diagnostic-worker 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

# Web UI 포트
WEB_PORT=8000

# ZDM 좌표 default — install 모달 default. 운영자가 모달에서 매 발행마다 override 가능.
# POST /api/v1/tasks/install body 의 zdm_ip · zdm_user 누락 시 본 값으로 fallback.
# config.py default = "host.lima.internal:8000" (ADR 0018 dev-only ZDM mock). 사내 staging 등
# 다른 ZDM 으로 발행 검증할 때만 본 줄 주석 해제 + 실제 좌표 박음.
#ZDM_DEFAULT_IP=host.lima.internal:8000
#ZDM_DEFAULT_USER=admin@zconverter.com

# ZDM 본체 패키지 contract — task.install download 필드로 발행.
# sha256·size_bytes 는 publish 직전 ZDM 에서 HEAD + GET 으로 동적 산출 (ETag Redis cache).
# Linux 호스트 (install.type=shell) — tar.gz extract + install.sh exec
#ZDM_PACKAGE_PATH=/download/ZConverter_CloudSource_Setup_Linux.tar.gz
#ZDM_PACKAGE_SCRIPT=zconverter_install_source/install.sh
# Windows 호스트 (install.type=direct_exec, ADR 0019) — single binary 직접 실행, script 없음
#ZDM_PACKAGE_PATH_WINDOWS=/download/ZConverter_CloudSource_Setup_Windows.exe

# install.sh wall-clock timeout — 원격 host worker 가 강제 종료
#INSTALL_TIMEOUT_SEC=600

# 에이전트 재시작 alert 임계값 (1h 슬라이딩 윈도우 내 횟수). attention 신호 카드 + consumer 부가 시그널.
#AGENT_RESTART_ALERT_THRESHOLD=3

# pgAdmin GUI 포트 (dev compose 한정)

# ────────────────────────────────────────────────────────────────────────────
# 3. 진단 publish 채널 — web · diagnostic-worker 공유
#    (consumer 사용 안 함)
# ────────────────────────────────────────────────────────────────────────────

# 진단 워크플로 자체 활성 flag (ADR 0004 + 0010). false 면 web POST /api/v1/diagnostics
# 503 + scheduler cron 발화 no-op. 운영자가 명시 활성해야 진단 흐름 동작.
#DIAGNOSTIC_ENABLED=false
#DIAGNOSTIC_ROUTING_KEY=diagnostic.request

# ────────────────────────────────────────────────────────────────────────────
# 4. diagnostic-worker 전용 — web · consumer 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

# 진단 narrative 합성 LLM. mock | ollama. 과금 발생 외부 API 호출은 정책상 금지 (#A0).
LLM_PROVIDER=mock
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b

# 단일 진단 1건 전체 timeout cap. 클라이언트 polling timeout(5분) 과 정렬.
#WORKER_JOB_TIMEOUT_SECONDS=300

# ADR 0023: scheduler cron 폐기. trigger 채널 = 사용자 명시 (web POST) 만.

# ────────────────────────────────────────────────────────────────────────────
# 5. RAG (ADR 0024) — diagnostic-worker + ingest CLI 공통
# ────────────────────────────────────────────────────────────────────────────

# RAG 활성 flag — false default. handler retrieve_context 단계 skip + payload['rag_context']=[]
#RAG_ENABLED=false

# embedding provider — mock (deterministic random, 비용 0) 또는 ollama (mxbai-embed-large)
#EMBEDDING_PROVIDER=mock
#EMBEDDING_MODEL=mxbai-embed-large
#EMBEDDING_DIMENSION=1024
#EMBEDDING_TIMEOUT_SECONDS=30.0

# RAG 검색 top-k + LLM context 본문 max 길이
#RAG_TOP_K=5
#RAG_MAX_CONTEXT_CHARS=4000
