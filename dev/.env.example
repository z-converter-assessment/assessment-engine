# dev 파이프라인 환경변수 카탈로그 (#A0). dev-up.sh 가 본 파일을 루트 `.env` 로 복사 -> compose 가 읽는다.
# libvirt VM·ZDM mock 등 dev 파이프라인 전용 값(ZDM_DEFAULT_IP 홈서버 IP, RESOLVER_HOST_OVERRIDE 등) 포함.
# 배포 템플릿(릴리즈 첨부)은 루트 `.env.example`. 본 파일은 dev 검증 전용 — 둘 다 루트 `.env` 로 떨어져 compose 가 읽음.
#
# host 값(POSTGRES_HOST·REDIS_HOST·RABBITMQ_HOST)은 compose 서비스명 — compose network 안에서만 DNS 해석.

# ────────────────────────────────────────────────────────────────────────────
# 1. 공통 — web · consumer · diagnostic-worker 모두 의무
# ────────────────────────────────────────────────────────────────────────────

# 환경 마커. prod 일 때 model_validator 가 weak default 거부 (#F8).
APP_ENV=dev
# 로그 출력 format. text=dev colorized·grep 친화, json=prod 외부 log aggregator.
#LOG_FORMAT=text

# PostgreSQL (TimescaleDB) — docker compose 서비스명
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# Redis — docker compose 서비스명
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ broker 접속 + routing 계약
# - 에이전트는 본 .env 를 안 씀 — pipeline-up.sh 가 dev/agent.env 를 OrbStack VM 안
#   /etc/assessment-agent.env 로 옮긴다. 에이전트의 RABBITMQ_HOST 는
#   "host.docker.internal"(OrbStack 이 컨테이너·VM 양쪽에서 host 로 해석) 로 별도 주입.
# - EXCHANGE / ROUTING_KEY_* 는 에이전트 <-> consumer routing 계약. 변경 시 양쪽 동시 동기화.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# task.install 발행 / task.result 수신 — collector exchange 와 분리. agent(dev/agent.env) WORKER_TASK_* 와 값 일치.
RABBITMQ_TASK_EXCHANGE=assessment.tasks
RABBITMQ_TASK_QUEUE_PREFIX=agent.tasks
RABBITMQ_TASK_INSTALL_KEY_PREFIX=task.install
RABBITMQ_ROUTING_KEY_TASK_RESULT=task.result
RABBITMQ_QUEUE_WORKER_RESULT=worker.result

# SQLAlchemy 엔진 SQL 로깅 (dev 디버깅용).
#SQLALCHEMY_ECHO=false

# ────────────────────────────────────────────────────────────────────────────
# 2. web 전용 — consumer · diagnostic-worker 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

# Web UI 포트
WEB_PORT=8000

# ZDM 좌표 — ZConverter install task 의 download.url host. [수동 설정 필요] 실제 ZDM 서버로 교체.
# 아래 dev 기본값(홈서버 LAN IP)은 dev 파이프라인용 — VM 이 도달하는 host:8000(ZDM mock).
ZDM_DEFAULT_IP=192.168.0.12:8000
#ZDM_DEFAULT_USER=admin@zconverter.com
# resolver(엔진) fetch host override. dev mock 은 web 컨테이너 자신이라 host publish 포트 hairpin 불가 ->
# localhost 로 sha256/size 산출. 실제 ZDM(운영) 사용 시 본 줄 비우거나 제거(엔진이 ZDM 직접 도달).
ZDM_RESOLVER_HOST_OVERRIDE=localhost:8000

# ZDM 본체 패키지 경로(ZDM_PACKAGE_*)는 제품 layout 상수라 미수록 — config.py default 사용 (dev mock 도 동일 path).

# install.sh wall-clock timeout — 원격 host worker 가 강제 종료
#INSTALL_TIMEOUT_SEC=600

# ────────────────────────────────────────────────────────────────────────────
# 3. 진단 publish 채널 — web · diagnostic-worker 공유
#    (consumer 사용 안 함)
# ────────────────────────────────────────────────────────────────────────────

#RABBITMQ_ROUTING_KEY_DIAGNOSTIC=diagnostic.request

# ────────────────────────────────────────────────────────────────────────────
# 4. diagnostic-worker 전용 — web · consumer 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

# 진단 narrative 합성 LLM — ollama 단독 (ADR 0025). 과금 발생 외부 유료 API 호출 금지 (#A0).
# 파이프라인 검증 한정: dev compose 에서 ollama 컨테이너 제거됨 (LLM 호출 실패 시나리오 의도 재현,
# docker-compose.yml diagnostic-worker 주석 참조). 본 OLLAMA_BASE_URL 의 `ollama` 호스트는 DNS
# 미해석 -> AI 진단(engineer 보고서 narrative) 발행 시 LLM 호출 실패. 값은 의도적으로 그대로 둔다
# (실패 경로 유지). 정상 LLM 동작을 원하면 docker-compose.yml 에 ollama 서비스 복원 + 모델 pull.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ADR 0023: scheduler cron 폐기. trigger 채널 = 사용자 명시 (web POST) 만.

# ────────────────────────────────────────────────────────────────────────────
# 5. RAG (ADR 0024) — diagnostic-worker + ingest CLI 공통
# ────────────────────────────────────────────────────────────────────────────

# RAG 활성 flag — false default. handler retrieve_context 단계 skip + payload['rag_context']=[]
#RAG_ENABLED=false

# embedding provider — mock (deterministic random, 비용 0) 또는 ollama (mxbai-embed-large)
#EMBEDDING_PROVIDER=mock
#EMBEDDING_MODEL=mxbai-embed-large
#EMBEDDING_DIMENSION=1024
#EMBEDDING_TIMEOUT_SECONDS=30.0

# RAG 검색 top-k + LLM context 본문 max 길이
#RAG_TOP_K=5
#RAG_MAX_CONTEXT_CHARS=4000
