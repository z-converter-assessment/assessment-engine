# 시크릿
.env
dev/.env
dev/agent.env
secrets/

# 빌드 산출물 — agent 바이너리는 dev-up.sh / dev/agent-build/build.sh 가 빌드
# (sibling repo Docker cross-build) 또는 AGENT_BINARY_URL 로 fetch.
dev/bin/assessment-agent

# libvirt dev 런타임 — dev SSH keypair + cloud-init seed/디스크 staging (dev-up.sh 생성).
dev/.ssh/
dev/run/

# 빌드 산출물
dist/
build/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# macOS
.DS_Store

# 테스트 / 빌드 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage*.xml
htmlcov/

# 런타임 로그
*.log

# 인프라 상태
.vagrant/

# 에디터 (JetBrains 통째 무시 / VS Code는 공용 규칙만 화이트리스트)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code 런타임 상태 (CLAUDE.md는 프로젝트 규약이므로 제외)
.claude/*.lock
# Claude Code 개인 로컬 오버라이드 (settings.json은 팀 공유, .local.json은 개인용)
.claude/settings.local.json

