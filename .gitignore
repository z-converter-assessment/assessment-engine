# 시크릿
.env
.env.*
*.pem
*.key
secrets/*
!secrets/.gitkeep
!secrets/README.md

# 빌드 산출물
dist/
build/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# merge 잔여물
*.orig
*.rej

# 테스트 / 빌드 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage*.xml
htmlcov/

# 런타임 로그
*.log

# 인프라 상태
.vagrant/

# 에디터 (JetBrains 통째 무시 / VS Code는 공용 규칙만 화이트리스트)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code 런타임 상태 (CLAUDE.md는 프로젝트 규약이므로 제외)
.claude/*.lock
# Claude Code 개인 로컬 오버라이드 (settings.json은 팀 공유, .local.json은 개인용)
.claude/settings.local.json


# 표현계층 타입 도구 (dev/CI 전용). 생성 타입(static/js/generated/)은 커밋 — drift 게이트 대상.
node_modules/
openapi.json
