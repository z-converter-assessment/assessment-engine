# dev 템플릿 — `cp .env.dev.example .env && docker compose up` (base + override.yml 자동 머지, 핫리로드).
# 코드 기본값으로 충분한 키는 두지 않는다 — 전체 키 카탈로그는 docs/reference/contracts/env.md.

# 컨테이너·네트워크·볼륨 이름의 접두. 없으면 디렉토리명을 쓴다.
COMPOSE_PROJECT_NAME=dev

# dev 는 file-secret 대신 env 채널을 쓴다.
POSTGRES_PASSWORD=assessment
RABBITMQ_PASSWORD=assessment

# install 모달 기본 입력값 — 실 ZDM 좌표로 교체.
ZDM_DEFAULT_IP=192.168.3.94
