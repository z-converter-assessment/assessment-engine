# 환경변수 배포 템플릿 — 릴리즈 첨부. [필수] 값을 확인한 뒤 `docker compose up -d` 로 기동.

# ────────────────────────────────────────────────────────────────────────────
# 1. 공통 — web · consumer · diagnostic-worker 모두 의무
# ────────────────────────────────────────────────────────────────────────────

# 환경 마커. prod = weak default 거부 (#F8).
APP_ENV=prod
# 로그 출력 format. prod 는 json (외부 log aggregator indexing).
LOG_FORMAT=json

# ── 이미지·영속 볼륨 (base docker-compose.yml, ADR 0035) ──
# ENGINE_IMAGE — GHCR 선빌드 이미지(public — 토큰 없이 pull). 미설정 시 base 기본값(릴리즈 CI 가 태그 semver 로 핀한 GHCR 이미지).
#ENGINE_IMAGE=ghcr.io/z-converter-assessment/assessment-engine:0.3.1
# 영속 볼륨 host bind — 미설정 시 named volume(postgres_data·rabbitmq_data). 외부 디스크(Cinder 등) 경로 주입.
#PGDATA_HOST=/mnt/pgdata
#MQ_DATA_HOST=/mnt/mqdata

# PostgreSQL (TimescaleDB). POSTGRES_HOST 는 compose 서비스명 — 외부 managed DB 면 교체.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment      # 변경 권장 (빈값·password·admin·root·changeme 는 거부, assessment 기본값은 허용)

# [필수] POSTGRES_PASSWORD — secret 채널 주입(권장) 또는 .env 직접 주입. 미설정이면 prod 기동 거부.
POSTGRES_PASSWORD=assessment

# Redis — docker compose 서비스명
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ broker 접속 + routing 계약
# - EXCHANGE / ROUTING_KEY_* 는 에이전트 <-> consumer routing 계약 — 변경 시 양쪽 동시 동기화.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=assessment      # 변경 권장 (빈값·password·admin·root·changeme 는 거부, assessment 기본값은 허용)

# [필수] RABBITMQ_PASSWORD — secret 채널 주입(권장) 또는 .env 직접 주입. 미설정이면 prod 기동 거부.
RABBITMQ_PASSWORD=assessment

RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# task.install 발행 / task.result 수신 — collector exchange 와 분리. agent(dev/agent.env) WORKER_TASK_* 와 값 일치.
RABBITMQ_TASK_EXCHANGE=assessment.tasks
RABBITMQ_TASK_QUEUE_PREFIX=agent.tasks
RABBITMQ_TASK_INSTALL_KEY_PREFIX=task.install
RABBITMQ_ROUTING_KEY_TASK_RESULT=task.result
RABBITMQ_QUEUE_WORKER_RESULT=worker.result

# SQLAlchemy 엔진 SQL 로깅 (dev 디버깅용).
SQLALCHEMY_ECHO=false

# ────────────────────────────────────────────────────────────────────────────
# 2. web 전용
# ────────────────────────────────────────────────────────────────────────────

# Web UI 포트
WEB_PORT=8000

# install 모달의 기본 입력값
ZDM_DEFAULT_IP=192.168.3.94
ZDM_DEFAULT_USER=admin@zconverter.com

# install.sh wall-clock timeout — agent에 전달
INSTALL_TIMEOUT_SEC=600

# ────────────────────────────────────────────────────────────────────────────
# 3. 진단 publish 채널 — web · diagnostic-worker 공유
# ────────────────────────────────────────────────────────────────────────────

RABBITMQ_ROUTING_KEY_DIAGNOSTIC=diagnostic.request

# ────────────────────────────────────────────────────────────────────────────
# 4. diagnostic-worker 전용
# ────────────────────────────────────────────────────────────────────────────

# 진단 narrative 합성 LLM — ollama
#OLLAMA_BASE_URL=http://ollama:11434
#OLLAMA_MODEL=qwen2.5:1.5b

