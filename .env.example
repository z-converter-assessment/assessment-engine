# prod 배포 템플릿. bootstrap.sh 가 이 파일을 배포 디렉토리의 .env 로 배치한다.
# 전체 키 카탈로그는 docs/reference/contracts/env.md.
# 비밀번호는 secrets/{postgres,rabbitmq}_password 파일로만 주입한다. 여기 두면 기동을 거부한다.

# 합칠 compose 파일 목록. 지우면 compose 기본 규칙이 dev override 를 딸려 온다.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# 배포 버전 핀. `deploy.sh vX.Y.Z` 가 이 줄을 갱신한다.
#ENGINE_IMAGE=ghcr.io/z-converter-assessment/assessment-engine:1.2.1

# 영속 볼륨을 외부 디스크에 둘 때만. 미설정이면 named volume.
#PGDATA_HOST=/mnt/pgdata
#MQ_DATA_HOST=/mnt/mqdata

# 호스트 퍼블리시 포트. 기본값(web 8000·amqp 5672·mgmt 15672·pg 5432·redis 6379)을 바꿀 때만.
#WEB_PUBLISH_PORT=8000
#RABBITMQ_PUBLISH_PORT=5672

# 코드 기본값이 dev·text 라 prod 는 명시한다.
APP_ENV=prod
LOG_FORMAT=json
LOG_LEVEL=INFO

# 계정 이름 — compose 가 컨테이너 초기화에도 쓴다. password/admin/root/changeme 는 거부된다.
POSTGRES_USER=assessment
RABBITMQ_USER=assessment

# 에이전트와의 routing 계약
#RABBITMQ_EXCHANGE=assessment
#RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
#RABBITMQ_ROUTING_KEY_METRICS=server.metrics
#RABBITMQ_ROUTING_KEY_ERROR=server.error
#RABBITMQ_TASK_EXCHANGE=assessment.tasks
#RABBITMQ_TASK_QUEUE_PREFIX=agent.tasks
#RABBITMQ_TASK_INSTALL_KEY_PREFIX=task.install
#RABBITMQ_ROUTING_KEY_TASK_RESULT=task.result
#RABBITMQ_QUEUE_WORKER_RESULT=worker.result

# install 모달 기본 입력값 — 실 ZDM 좌표로 교체. 기본값이 없어 비워두면 모달이 빈 채로 뜬다.
ZDM_DEFAULT_IP=192.168.3.94
