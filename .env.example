# dev 환경 자격·구성 카탈로그 (#A0). `cp .env.example .env` 후 그대로 사용 가능 — pipeline-up.sh가 자동 cp.

APP_ENV=dev

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# RabbitMQ
# - HOST/PORT는 web/consumer 컨테이너에서 broker 접속에 사용.
# - 에이전트는 본 .env를 안 씀 — pipeline-up.sh가 dev/agent.env를 source해 Lima VM 안 /etc/assessment-agent.env로 옮긴다.
#   에이전트의 RABBITMQ_HOST는 pipeline-up.sh가 "host.lima.internal"(Lima user-mode network alias)로 별도 주입.
# - EXCHANGE/ROUTING_KEY_*는 에이전트 ↔ consumer routing 계약. 기본값 변경 시 양쪽 동시 동기화.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Web
WEB_PORT=8000

# 원격 작업 install bundle endpoint (ADR 0007 / 0009)
# - task.install download.url에 그대로 박혀 발행됨. agent worker가 이 URL로 fetch.
# - dev plain HTTP (ADR 0009).
INSTALL_BUNDLE_URL=http://host.lima.internal:8000/zconverter.tar.gz

# SQLAlchemy 엔진 SQL 로깅 (dev 디버깅용).
#SQLALCHEMY_ECHO=false

# pgAdmin GUI 포트
#PGADMIN_PORT=5050

# 진단 (ADR 0004 / 0010)
# - LLM_PROVIDER는 mock|ollama. 과금 발생 외부 API 호출은 정책상 금지 (#A0).
# - 나머지 키는 default 있음 — 조정 필요 시 활성화.
LLM_PROVIDER=mock
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b
#LLM_TIMEOUT_SECONDS=60
#LLM_MOCK_LATENCY_SECONDS=2.0
#DIAGNOSTIC_ROUTING_KEY=diagnostic.request
#DIAGNOSTIC_RETENTION_DAYS=90
#DIAGNOSTIC_SCHEDULE_CRON=0 3 * * *
#DIAGNOSTIC_ACTIVE_SERVER_WINDOW_HOURS=24
#WORKER_JOB_TIMEOUT_SECONDS=300
