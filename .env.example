# dev 환경 자격·구성 카탈로그. `cp .env.example .env` 후 사용.
# - dev: 본 파일의 값을 그대로 사용해도 무방 (model_validator는 prod에서만 약한 default 차단).
# - prod: 본 파일을 직접 .env로 복사하지 말 것. 자격은 Docker secrets로 주입 (./secrets/* + docker-compose.prod.yml).
#         prod에서 APP_ENV=prod일 때 약한 default("assessment" 등)는 config.py model_validator가 거부한다.

# 환경 마커. dev | staging | prod
APP_ENV=dev

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# RabbitMQ
# - HOST/PORT는 web/consumer 컨테이너에서 broker 접속에 사용.
# - 에이전트는 본 .env를 사용하지 않는다 — Vagrantfile이 infra/agent.env에서
#   RABBITMQ_USER/PASSWORD/EXCHANGE/ROUTING_KEY_*만 읽어 VM 안
#   /etc/assessment-agent.env로 옮긴다. 에이전트의 RABBITMQ_HOST는
#   Vagrantfile에서 "10.0.2.2"(NAT → 호스트머신)로 별도 주입.
# - EXCHANGE/ROUTING_KEY_*는 에이전트 ↔ consumer routing 계약.
#   기본값 변경 시 양쪽이 함께 같은 값을 써야 한다.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=assessment
RABBITMQ_PASSWORD=assessment
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error
RABBITMQ_ROUTING_KEY_TASK_RESULT=task.result

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Web
WEB_PORT=8000

# SQLAlchemy 엔진 SQL 로깅 (dev 디버깅용). 운영은 false 유지 — 로그 폭증·secret 노출 위험.
#SQLALCHEMY_ECHO=false

# pgAdmin GUI 포트 (dev override만 활성)
#PGADMIN_PORT=5050

# AI 진단 (ADR 0004)
# - LLM_PROVIDER는 mock|ollama. 과금 발생 외부 API(Anthropic 등) 호출은 운영자 정책상 금지.
# - 나머지 키는 default가 있어 본 파일에 명시 안 해도 됨 — 운영 중 조정 필요 시 활성화.
LLM_PROVIDER=mock
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b
#LLM_TIMEOUT_SECONDS=60
#LLM_MOCK_LATENCY_SECONDS=2.0
#DIAGNOSTIC_ROUTING_KEY=diagnostic.request
#DIAGNOSTIC_RETENTION_DAYS=90
#DIAGNOSTIC_SCHEDULE_CRON=0 3 * * *
#DIAGNOSTIC_ACTIVE_SERVER_WINDOW_HOURS=24
#WORKER_JOB_TIMEOUT_SECONDS=300