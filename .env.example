# prod 운영자 환경변수 카탈로그 (#A0). 본 파일은 운영자가 자기 환경 (VM·k8s·systemd) 에 맞춰
# 채울 placeholder. 외부 인프라가 wheel 받아 install 후 본 카탈로그 따라 노드별 env file 작성.
#
# 본 repo 의 dev compose (docker compose) 는 별도 — `dev/.env.example` 가 dev 기준 default.
# 운영자가 본 파일을 `cp .env.example .env` 후 채워서 사용 (gitignore 됨).
#
# 컴포넌트별 의무 매트릭스 단일 진실: docs/operations/env.md "컴포넌트별 의무 매트릭스" 절.
# prod weak default 거부 (`_validate_prod_*`) — 빈 값·`assessment`·`password` 등 거부.
#
# 분산 배포 시 (web · consumer · diagnostic-worker · diagnostic-scheduler 가 별 VM) 각 노드별
# 필요 변수만 골라 박는다. systemd EnvironmentFile · k8s Secret · Vault 등 채널 자유 (#A0).

# ────────────────────────────────────────────────────────────────────────────
# 1. 공통 — web · consumer · diagnostic-worker · diagnostic-scheduler 모두 의무
# ────────────────────────────────────────────────────────────────────────────

# 환경 마커. prod 일 때 weak default 거부 활성.
APP_ENV=prod
# 로그 출력 format. prod 권장 json (외부 log aggregator indexing).
LOG_FORMAT=json

# PostgreSQL (TimescaleDB) — 운영 호스트·자격 명시 의무.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis — 운영 호스트 명시 의무.
REDIS_HOST=
REDIS_PORT=6379

# RabbitMQ broker 접속 + routing 계약
# EXCHANGE · ROUTING_KEY_* 는 에이전트 측 contract 와 일치 — 변경 시 양쪽 동시 동기화.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/assessment
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_EXCHANGE=assessment
RABBITMQ_ROUTING_KEY_INVENTORY=server.inventory
RABBITMQ_ROUTING_KEY_METRICS=server.metrics
RABBITMQ_ROUTING_KEY_ERROR=server.error

# SQLAlchemy 엔진 SQL 로깅 (운영 환경은 false 유지 — 로그 폭증·secret 노출 위험).
#SQLALCHEMY_ECHO=false

# ────────────────────────────────────────────────────────────────────────────
# 2. web 전용 — consumer · diagnostic-worker · diagnostic-scheduler 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

# Web UI 포트 (외부 ingress 가 TLS termination, 앱은 plain HTTP)
WEB_PORT=8000

# ZDM 좌표 default — install 모달 default. 각 고객사 ZDM 좌표로 의무 override.
# dev default (192.168.3.94 · admin@zconverter.com) 그대로면 prod 검증 거부.
ZDM_DEFAULT_IP=
ZDM_DEFAULT_USER=

# ZDM 본체 패키지 contract — task.install download 필드로 발행. ZDM 측 layout 과 일치.
# sha256·size_bytes 는 publish 직전 ZDM 에서 HEAD + GET 으로 동적 산출 (ETag Redis cache).
#ZDM_PACKAGE_PATH=/download/ZConverter_CloudSource_Setup_Linux.tar.gz
#ZDM_PACKAGE_SCRIPT=zconverter_install_source/install.sh

# install.sh wall-clock timeout — 원격 host worker 가 강제 종료
#INSTALL_TIMEOUT_SEC=600

# 에이전트 재시작 alert 임계값 (1h 슬라이딩 윈도우 내 횟수). attention 신호 카드 + consumer 부가 시그널.
#AGENT_RESTART_ALERT_THRESHOLD=3

# ────────────────────────────────────────────────────────────────────────────
# 3. 진단 publish 채널 — web · diagnostic-worker · diagnostic-scheduler 공유
#    (consumer 사용 안 함)
# ────────────────────────────────────────────────────────────────────────────

# 진단 워크플로 활성 flag (ADR 0004 + 0010). 운영자가 명시 활성해야 진단 흐름 동작.
#DIAGNOSTIC_ENABLED=false
#DIAGNOSTIC_ROUTING_KEY=diagnostic.request

# ────────────────────────────────────────────────────────────────────────────
# 4. diagnostic-worker 전용 — web · consumer · diagnostic-scheduler 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

# 진단 narrative 합성 LLM — ollama 단독 (ADR 0025: mock provider 폐기). 과금 외부 API 금지 (#A0).
# diagnostic-worker 가 도달 가능한 ollama 서버 좌표 + 모델. `ollama pull <model>` 선행 의무.
OLLAMA_BASE_URL=http://<ollama-host>:11434
OLLAMA_MODEL=llama3.1:8b

# 단일 진단 1건 전체 timeout cap. 클라이언트 polling timeout(5분) 과 정렬.
#WORKER_JOB_TIMEOUT_SECONDS=300

# ────────────────────────────────────────────────────────────────────────────
# 5. diagnostic-scheduler 전용 — web · consumer · diagnostic-worker 사용 안 함
# ────────────────────────────────────────────────────────────────────────────

#DIAGNOSTIC_SCHEDULE_CRON=0 3 * * *
#DIAGNOSTIC_RETENTION_DAYS=90
